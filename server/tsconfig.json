{
  "include": [
    "src",
    "src/modules/category/.router.ts",
    "src/modules/transactions/constants.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
